<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Health Connect 客户端库自己声明了 minSdk 26，而本应用是 24。
         合并清单默认会因此直接报错，overrideLibrary 是官方给的例外口子：
         老系统照样装得上，能不能用由运行时判断（getSdkStatus + MainActivity 的版本闸）。 -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 录音附件 / 录音页：WebView RustWebChromeClient 将 AUDIO_CAPTURE 映射为这两个运行时权限请求 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 户外跑定位：WebView navigator.geolocation 依赖这两项运行时权限 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 跑步前台保活：锁屏后维持 GPS 与计时，防止进程被冻结/回收（用户感知为崩溃） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 训练课常驻通知：课程不取定位，用 specialUse 型（Android 14+ 才有该型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 全局浮窗：「在其他应用上显示」是特殊权限，不弹运行时授权框，只能由用户在系统设置页
         逐应用授予（判定走 Settings.canDrawOverlays，见 GlobalFloatBridge.kt）。
         未授权时全局浮窗降级为仅程序内浮条，不阻塞任何既有功能。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 通知触感：常驻通知本身 IMPORTANCE_LOW 不震，留着给课程相位提醒等后续用途 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 应用内自更新：把验签通过的 APK 交给系统安装器（见 UpdateBridge.kt）。
         Android 8+ 还需用户在系统设置里允许 Rein「安装未知应用」，
         未授权时 UpdateBridge 会跳转设置页并让前端提示。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 第三方健康数据（见 modules/healthsync + HealthConnectBridge.kt）：
         从系统 Health Connect 读取运动记录与每日体征，并按用户开关回写。
         这几项**不是**运行时权限 —— 系统不弹窗，只能在 Health Connect 自己的界面上授予，
         所以声明在这里只是「声明意图」，真正拿到授权要走 HC 的授权页。
         分四组（口径见 HealthConnectBridge.kt 的 CATEGORY_*，与前端 healthMetrics.ts 对应）：
         运动 / 活动与睡眠 / 身体成分 / 身体机能 —— 用户可以只授其中几组，
         未授权的组在读取侧被逐项跳过，不影响其它组。 -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />

    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />

    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <!-- Health Connect 只在 Android 9+ 且系统带 HC 模块（Android 14+）时存在。
         声明成 required=false：老机器照样装得上，装上一看就知道这功能不可用。 -->
    <uses-feature android:name="android.software.health.connect" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.rein"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- 系统分享（其他应用把内容分享给 Rein）：图片 / 文本 / Markdown / Office -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>

            <!-- 系统打开方式（文件管理器等直接打开） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
        </activity>

        <!-- 跑步采集前台服务：原生采集是运动真源（取点/计时/落轨迹都在这里），
             由 TrackingBridge 在开跑/开课时拉起（见 modules/tracking + RunTrackingService.kt）。
             两种前台服务类型共用同一个通知 id：location=采集、specialUse=训练课常驻通知。 -->
        <service
            android:name=".RunTrackingService"
            android:exported="false"
            android:foregroundServiceType="location|specialUse">
            <!-- Android 14+ 要求 specialUse 型声明用途子类，缺了会在启动前台服务时被拒 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="strength_training" />
        </service>

        <!-- 全局沉浸浮窗（见 GlobalFloatBridge.kt / GlobalFloatService.kt）：
             原生 WindowManager 浮层要在应用退到后台后继续显示，只能挂在一种系统不随手回收的
             宿主上 —— 前台服务就是那个宿主；通知则是进程被回收后用户唯一的重启入口。
             specialUse：浮层不是定位也不是媒体播放，Android 14+ 归到「特殊用途」并要求声明子类。 -->
        <service
            android:name=".GlobalFloatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="global_float_overlay" />
        </service>

        <!-- 健康数据用途说明（见 HealthRationaleActivity.kt）。
             **权限能否使用的前提**：android.permission.health.* 在 Android 14+ 要求
             应用声明一个处理 VIEW_PERMISSION_USAGE + HEALTH_PERMISSIONS 的页面，
             否则 HC 判定「健康权限状态不完整」—— 授权页秒退、读写全被拒。
             两个 intent-filter 对应两套机制：VIEW_PERMISSION_USAGE 是 Android 14+ 的
             系统健康权限口径；ACTION_SHOW_PERMISSIONS_RATIONALE 是 androidx
             connect-client 走 Play 版 HC 时用的旧口径。两个都给，两端都能走。 -->
        <activity
            android:name=".HealthRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
